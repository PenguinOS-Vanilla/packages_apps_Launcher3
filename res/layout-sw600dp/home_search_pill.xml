<?xml version="1.0" encoding="utf-8"?>
<!--
     iOS-style "Search on Home screen" pill shown in the dock's search slot.
     Based on the PenguinOS Launcher3 search pill (SPDX-License-Identifier: Apache-2.0).
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_search_pill"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/home_search_pill_height"
    android:minWidth="@dimen/home_search_pill_min_width"
    android:background="@drawable/bg_home_search_pill"
    android:foreground="?android:attr/selectableItemBackgroundBorderless"
    android:drawableStart="@drawable/ic_home_search_pill"
    android:drawablePadding="5dp"
    android:drawableTint="@color/home_search_pill_content"
    android:gravity="center"
    android:includeFontPadding="false"
    android:paddingStart="13dp"
    android:paddingEnd="15dp"
    android:text="@string/home_search_pill"
    android:contentDescription="@string/home_search_pill"
    android:textColor="@color/home_search_pill_content"
    android:textSize="14sp"
    android:singleLine="true"
    android:fontFamily="@*android:string/config_bodyFontFamily" />
